{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/usthbstudy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "usthbstudy",
    "Audience": "usthbstudy",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "_storage"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "PermitPerMinute": 100,
    "AuthPermitPerMinute": 10
  },
  "Seed": {
    "DemoUsers": false
  },
  "AllowedHosts": "*"
}
